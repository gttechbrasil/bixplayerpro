# ---- Domain / URLs -------------------------------------------------------
DOMAIN=player.exemplo.com.br
PUBLIC_BASE_URL=https://player.exemplo.com.br

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=iptv
POSTGRES_USER=iptv
POSTGRES_PASSWORD=troque-esta-senha
# Used by the API when running outside compose (local dev):
DATABASE_URL=postgresql+asyncpg://iptv:troque-esta-senha@localhost:5432/iptv

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Security --------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-segredo-longo
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# JWT lifetime for admin/reseller sessions (minutes)
JWT_EXPIRE_MINUTES=720
# Set to true behind HTTPS (production). false only for local http dev.
COOKIE_SECURE=true
# Comma separated list of extra allowed origins (leave empty when served by Caddy on the same domain)
CORS_ORIGINS=

# ---- Seed / first admin ----------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ---- Platform ----------------------------------------------------------------
PLATFORM_NAME=Minha Plataforma
# Directory for uploaded images (logo/background). In compose it is the `uploads` volume.
UPLOAD_DIR=/app/uploads
# Locally administered MAC prefix (3 bytes) used to generate device MACs
MAC_PREFIX=02:50:50
# Rate limit for login endpoints: attempts per window (seconds)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
# Rate limit for the public device endpoints, per window of DEVICE_RATE_WINDOW seconds:
# registrations per IP, calls per device (register and config) and config calls per IP
DEVICE_RATE_WINDOW=60
DEVICE_REGISTER_RATE_LIMIT=30
DEVICE_RATE_LIMIT=20
DEVICE_RATE_LIMIT_IP=600

# ---- Payments (Pix / Mercado Pago) -----------------------------------------
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Sandbox only (TEST- token): regular-looking payer e-mail; @testuser.com addresses are refused. Leave empty in production.
MERCADOPAGO_TEST_PAYER_EMAIL=
# Validity of the Pix QR code in minutes
PIX_EXPIRATION_MINUTES=30

# ---- Runtime ---------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info
