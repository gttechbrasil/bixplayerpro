# Reverse proxy: /api/* -> FastAPI, everything else -> SvelteKit.
# TLS is provisioned automatically by Caddy (Let's Encrypt) for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		# Largest legitimate body is the 2 MB branding upload.
		request_body {
			max_size 8MB
		}
		reverse_proxy api:8000
	}

	# Images uploaded by resellers (logo/background), shared volume with the api
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
		header Cache-Control "public, max-age=86400"
	}

	# Release APK published by deploy.sh --apk (bind mount of deploy/downloads on the host)
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
		header Cache-Control "no-cache"
		header Content-Type "application/vnd.android.package-archive"
	}

	handle {
		# SvelteKit needs inline scripts/styles (hydration data, theme bootstrap); images may
		# come from any http(s) origin because banners and logos are URLs typed by resellers.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# www redirects to the apex domain (both A records point to the VPS)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
