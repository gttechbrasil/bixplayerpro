# Reverse proxy: /api/* -> FastAPI, everything else -> SvelteKit.
# TLS is provisioned automatically by Caddy (Let's Encrypt) for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	# Images uploaded by resellers (logo/background), shared volume with the api
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

# www redirects to the apex domain (both A records point to the VPS)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
